@media (max-width: 768px) {

    .text-5xl,
    .text-6xl {
        font-size: 3rem;
    }

    .text-4xl {
        font-size: 2.5rem;
    }

    .hero-pattern {
        padding-top: 100px;
        padding-bottom: 60px;
    }

    section {
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .max-w-7xl {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .demo-button {
        padding: 0.75rem !important;
        font-size: 0.875rem !important;
    }
}

@media (max-width: 640px) {

    .text-5xl,
    .text-6xl {
        font-size: 2.5rem;
    }

    .text-4xl {
        font-size: 2rem;
    }
}

img {
    max-width: 100%;
    height: auto;
}
